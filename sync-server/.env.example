# Required. Shared secret every Cherry Studio client sends as "Authorization: Bearer <token>".
# Generate one with: npm run generate-token   (or: openssl rand -base64 32)
SYNC_AUTH_TOKEN=

# Optional settings (defaults shown).
# HOST=0.0.0.0
# PORT=8787
# DATA_DIR=./data
# Maximum JSON body size for a single push request, in bytes (64 MiB).
# MAX_BODY_BYTES=67108864
# Maximum size of a single attachment/knowledge file blob, in bytes (1 GiB).
# MAX_BLOB_BYTES=1073741824
# Maximum number of changes returned per pull page.
# CHANGES_PAGE_SIZE=500
# Interval between SSE heartbeats, in milliseconds.
# SSE_HEARTBEAT_MS=25000
